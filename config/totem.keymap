#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_layer3_left {
            timeout-ms = <50>;
            key-positions = <24 25>;    // V,B
            bindings = <&mo 3>;
        };

        combo_layer3_right {
            timeout-ms = <50>;
            key-positions = <26 27>;    // N,M
            bindings = <&mo 3>;
        };

        combo_d_f_esc {
            timeout-ms = <50>;
            key-positions = <12 13>;    // d,f
            bindings = <&kp ESC>;
        };
        combo_j_k_tab {
            timeout-ms = <50>;
            key-positions = <16 17>;    // j,k
            bindings = <&kp TAB>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &kp Q            &kp W       &kp E           &kp R       &kp T       &kp Y           &kp U     &kp I             &kp O           &kp P
           &kp A            &kp S       &kp D           &kp F       &kp G       &kp H           &kp J     &kp K             &kp L           &kp SEMI
&none      &mt LSHFT Z      &mt LGUI X  &mt LCTRL C     &lt 1 V     &lt 2 B     &lt 2 N         &lt 1 M   &mt RCTRL COMMA   &mt RGUI DOT    &mt RSHFT FSLH  &none
                            &none       &kp BACKSPACE   &kp LANG1   &kp ENTER   &kp SPACE       &none
            >;
        };

        sym {
            bindings = <
           &kp EXCL     &kp AT      &kp HASH        &kp DOLLAR  &kp PERCENT     &kp CARET  &kp AMPERSAND    &kp ASTRK   &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS
           &none        &kp GRAVE   &kp BACKSLASH   &kp APOS    &kp ESC         &kp TAB    &kp PLUS         &kp MINUS   &kp LEFT_BRACE          &kp RIGHT_BRACE
&none      &none        &kp TILDE   &kp PIPE        &kp DQT     &none           &none      &kp EQUAL        &kp UNDER   &kp LEFT_BRACKET        &kp RIGHT_BRACKET        &none
                                    &trans          &trans      &trans          &trans     &trans           &trans
            >;
        };

        num_util {
            bindings = <
            &kp N1      &kp N2      &kp N3      &kp N4      &kp N5              &kp LC(LA(F1))  &kp LC(LA(F2))  &kp LC(LA(F3))  &kp LC(LA(F4))  &kp LC(LA(F5))
            &kp N6      &kp N7      &kp N8      &kp N9      &kp N0              &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &none
&none       &none       &none       &none       &none       &none               &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR
                                    &trans      &trans      &trans              &trans          &trans          &trans 
            >;
        };


        mouse_fun {
            bindings = <
       &kp C_VOLUME_UP      &kp LC(PAGE_UP)          &mmv MOVE_UP     &kp LC(PAGE_DOWN)     &none   &kp F1      &kp F2        &kp F3    &kp F4      &kp F5
       &kp C_VOLUME_DOWN    &mmv MOVE_LEFT           &mmv MOVE_DOWN   &mmv MOVE_RIGHT       &none   &kp F6      &kp F7        &kp F8    &kp F9      &kp F10
&none  &kp C_MUTE           &mkp LCLK                &mkp MCLK        &mkp RCLK             &none   &kp F11     &kp F12       &kp F13   &kp F14     &kp F15     &none
                                                     &none            &none                 &none   &none       &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

};
